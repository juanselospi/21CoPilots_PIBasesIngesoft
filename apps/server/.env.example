# Copie este archivo como .env dentro de apps/server/ (cp .env.example .env) y ajuste si hace falta.
# .env NUNCA se sube a Git; .env.example sí.

PUERTO=3000

# --- Base de datos ---
# Los mismos valores de conexión que database/.env
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dchobbies
DB_USER=dchobbies
DB_PASSWORD=dchobbies_dev

# --- Sesión ---
# Minutos que dura una sesión desde que se inicia.
DURACION_SESION_MINUTOS=25
# true: si la sesión se usa cuando le queda menos de la mitad, se extiende otra duración completa.
# Cualquier otro valor: vence a su hora aunque se esté usando.
SESION_RENOVAR=true
# Intentos fallidos de inicio de sesión con un mismo correo antes de bloquearlo,
# la ventana en la que se cuentan y cuánto dura el bloqueo, en minutos.
INTENTOS_DE_INICIO_MAXIMOS=5
VENTANA_DE_INTENTOS_MINUTOS=15
BLOQUEO_DE_INICIO_MINUTOS=10

# --- Recuperar la contraseña ---
# Minutos que sirve el enlace.
DURACION_RECUPERACION_MINUTOS=30
# Segundos que hay que esperar para que la misma cuenta reciba otro enlace.
ESPERA_ENTRE_ENLACES_SEGUNDOS=60
# Dónde está la tienda, para armar el enlace a /restablecer
URL_DE_LA_TIENDA=http://localhost:5173

# --- Correo ---
# simulado: no sale ningún correo, se escribe en el log del servidor y el enlace de
#           recuperación también viene en la respuesta si NODE_ENV no es production.
# smtp:     se manda de verdad con los datos de abajo. Sin ellos el servidor no arranca.
CORREO=simulado
# Con Gmail: cuenta con verificación en dos pasos y una contraseña de aplicación, sin espacios.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USUARIO=
SMTP_CONTRASENA=
# Quién aparece como remitente. Vacío: se usa SMTP_USUARIO.
CORREO_REMITENTE=

# Tamaño máximo del Excel de productos que se puede subir, en MB.
IMPORTACION_TAMANO_MAXIMO_MB=5

# --- Valores fijados por ley o por el SRS (no los edita el administrador) ---
# IMPUESTO_DE_VENTA es la tasa que la importacion guarda en cada producto
IMPUESTO_DE_VENTA=0.13
UMBRAL_EXISTENCIAS_BAJAS=2

# --- Adaptadores de los sistemas externos (RES-03) ---
# simulada | no-disponible. "no-disponible" sirve para probar RNF-06.
# Con la simulada, una tarjeta que termina en 0000 se rechaza y cualquier otra
# se aprueba; contra entrega queda pendiente. Sirve para mostrar los tres casos.
PASARELA_DE_PAGO=simulada
FACTURACION_ELECTRONICA=simulada
