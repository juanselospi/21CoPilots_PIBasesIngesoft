# Copie este archivo como .env dentro de apps/server/ (cp .env.example .env) y ajuste si hace falta.
# .env NUNCA se sube a Git; .env.example sí.

PUERTO=3000

# --- Base de datos ---
# Los mismos valores de conexión que database/.env
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dchobbies
DB_USER=dchobbies
DB_PASSWORD=dchobbies_dev

# --- Sesión ---
# Minutos que dura una sesión desde que se inicia.
DURACION_SESION_MINUTOS=25
# true: si la sesión se usa cuando le queda menos de la mitad, se extiende otra duración completa.
# Cualquier otro valor: vence a su hora aunque se esté usando.
SESION_RENOVAR=true

# Tamaño máximo del Excel de productos que se puede subir, en MB.
IMPORTACION_TAMANO_MAXIMO_MB=5

# --- Valores fijados por ley o por el SRS (no los edita el administrador) ---
# IMPUESTO_DE_VENTA es la tasa que la importacion guarda en cada producto
IMPUESTO_DE_VENTA=0.13
UMBRAL_EXISTENCIAS_BAJAS=2

# --- Adaptadores de los sistemas externos (RES-03) ---
# simulada | no-disponible  — "no-disponible" sirve para probar RNF-06.
PASARELA_DE_PAGO=simulada
FACTURACION_ELECTRONICA=simulada
