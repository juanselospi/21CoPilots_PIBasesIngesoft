# Copie este archivo como .env dentro de database/ (cp .env.example .env) y ajuste si hace falta.
# .env NUNCA se sube a Git; .env.example sí.

# --- Base de datos (usado por docker-compose.yml y los scripts de database/) ---
# apps/server tendrá su propio .env con estos mismos valores de conexión.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dchobbies
DB_USER=dchobbies
DB_PASSWORD=dchobbies_dev
