{
  "name": "dc-hobbies-database",
  "private": true,
  "description": "Comandos de base de datos compartidos por todo el equipo (ver README.md)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.js",
    "db:status": "node scripts/migrate.js --status",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "db:test": "node scripts/probar.js",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:dump": "node scripts/dump.js",
    "db:new": "node scripts/new-migration.js"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.0"
  }
}
